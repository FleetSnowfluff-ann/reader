{
  "name": "parallel-reader-translation",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://fleetsnowfluff-ann.github.io",
    "MONTHLY_CHAR_LIMIT": "100000",
    "DAILY_CHAR_LIMIT": "50000",
    "IP_DAILY_CHAR_LIMIT": "20000"
  },
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "TranslationBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TranslationBudget"] }]
}
